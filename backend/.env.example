# 后端全局配置
MAX_WORKERS=1

# 数据库配置
DATABASE_URL=postgresql://root:your-password@172.10.24.40:5432/resistor_adjustment?options=-c%20timezone=Asia/Shanghai

# Milvus 配置
MILVUS_URI=http://172.10.24.40:19530
MILVUS_DATABASE=resistor_adjustment
MILVUS_USER=root
MILVUS_PASSWORD=your-password
MILVUS_ENABLE_HYBRID_SEARCH=False
MILVUS_COLLECTION=resistor_adjustment_knowledge

# 嵌入模型配置 (aigate bge-m3, OpenAI 兼容格式, dim=1024)
EMBEDDING_URL=https://aigate.jptoe.com/v1/embeddings
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=your-api_key
EMBEDDING_LIMIT=3
# 检索相似度阈值（COSINE，0~1）：低于该值的命中不作为参考资料；按「会话记录」中的检索得分调整
EMBEDDING_SCORE_THRESHOLD=0.60
# 多轮追问时，改写检索问题参考的最近对话轮数（首轮不改写）
REWRITE_HISTORY_ROUNDS=3
# 每次嵌入请求携带的切片数、限流(429)时的最大重试次数
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=5

# 模型配置
LLM_URL=https://aigate.jptoe.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=your-api_key
# 大模型请求等待上限（秒，流式输出按两次收到数据的间隔计算）与失败重试次数；网关故障时决定用户多久看到报错
LLM_TIMEOUT=90
LLM_MAX_RETRIES=1
# 多轮问题改写的等待上限（秒），超时直接用原问题检索，不重试
REWRITE_TIMEOUT=15

# MinIO 配置
MINIO_ENDPOINT=172.10.24.40:9000
MINIO_ACCESS_KEY=your-access_key
MINIO_SECRET_KEY=your-secret_key
MINIO_BUCKET=resistor-adjustment
MINIO_SECURE=False

# Redis 配置（登录会话，DB 11，键前缀 resistor:）
REDIS_HOST=172.10.24.40
REDIS_PORT=6379
REDIS_PASSWORD=your-password
REDIS_DB=11

# 登录会话：连续无交互多少秒后过期（每次请求自动续期）
SESSION_EXPIRE_SECONDS=7200
# 会话 Cookie 是否仅限 HTTPS（内网 http 访问保持 False）
COOKIE_SECURE=False
